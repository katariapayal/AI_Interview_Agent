# Copy this file to .env and fill in your key before running locally.
# On your hosting platform (Render/Railway/Fly/etc.) set these as environment
# variables in the dashboard instead of committing a .env file.

# Required: your Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=YOUR_API_KEY

# Optional: override the model. Defaults to gemini-2.0-flash.
# Use whatever current model string your account has access to
# (e.g. gemini-2.0-flash, gemini-2.5-flash, gemini-2.5-pro).
GEMINI_MODEL=gemini-2.5-flash

# Optional: port for the server (most hosts inject PORT automatically)
PORT=3000
